<!-- $site https://phone1st-theme.uk -->
<!-- $sitename Phone1st Starter Theme for Html -->
<!-- $author h@phone1st.org -->

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title><!-- $SEO-title --> | <!-- $sitename --></title>
<meta name="description" content="<!-- $description -->" />
<link rel="canonical" href="<!-- $site -->/<!-- $url -->" />

<meta property="og:site_name" content="<!-- $sitename -->" />
<meta property="og:type" content="website" />
<meta property="og:title" content="<!-- $title -->" />
<meta property="og:description" content="<!-- $description -->" />
<meta property="og:url" content="<!-- $site -->/<!-- $url -->" />
<meta property="og:image" content="<!-- $site -->/<!-- $post-image -->" />
<meta property="og:image:alt" content="<!-- $title --> header image" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<!-- $title -->" />
<meta name="twitter:description" content="<!-- $description -->" />
<meta name="twitter:image" content="<!-- $site -->/<!-- $post-image -->" />

<!-- @import _schema-company -->

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta name="theme-color" content="#4A6741" />

<!-- Below hopefully stops the white flash seen when the dark mode kicks in -->
<script>
 const isDark =
  localStorage.theme === "dark" ||
  (!("theme" in localStorage) &&
   window.matchMedia("(prefers-color-scheme: dark)").matches);
 if (isDark) {
  document.documentElement.classList.add("dark");
 } else {
  document.documentElement.classList.remove("dark");
 }
</script>
<style>
 :root {
  background-color: var(--viewport-bg);
 }
 .dark {
  background-color: var(--viewport-bg);
 }
</style>
