<div class="theme-variables">
 <p class="p-0 mb-4">
  The default colors - see <em>css/base/_variables.scss</em> to change
 </p>
 <p class="p-0">
  The <em>$variables</em> below are fixed colors. The rest are
  <em>var(--variables)</em> and are able to work with the
  <em>dark-theme</em> mode.
 </p>
 <div class="first-color">
  <p>$first-color</p>
 </div>
 <div class="second-color">
  <p>$second-color</p>
 </div>
 <div class="black-color">
  <p>$black</p>
 </div>
 <div class="white-color">
  <p>$white</p>
 </div>
 <div class="dark-gray">
  <p>$dark-gray</p>
 </div>
 <div class="medium-gray">
  <p>$medium-gray</p>
 </div>
 <div class="light-gray">
  <p>$light-gray</p>
 </div>
 <div class="font-color">
  <p>font-color</p>
 </div>
 <div class="link-color">
  <p>link-color</p>
 </div>
 <div class="hover-color">
  <p>hover-color</p>
 </div>
 <div class="background">
  <p>background color</p>
 </div>
 <div class="light-background">
  <p>light background color</p>
 </div>
 <div class="border">
  <p>border and $radius</p>
 </div>
 <div class="error">
  <p>$error</p>
 </div>
 <div class="alert">
  <p>$alert</p>
 </div>
 <div class="success">
  <p>$success</p>
 </div>
</div>
<p>Spacings `$s-0` to `$s-15` - see the theme <em>variables</em></p>
<div class="margin-spacer">
 <div class="small-margin">
  <p>
   margin-left: $s-2;<br />
   padding: $s-2; - 0.5rem
  </p>
 </div>
 <div class="medium-margin">
  <p>
   margin-left: $s-4;<br />
   padding: $s-4; - 1rem
  </p>
 </div>
 <div class="normal-margin">
  <p>
   margin-left: $spacer; or $s-8;<br />
   padding: $spacer; or $s-8; - 2rem
  </p>
 </div>
 <div class="large-margin">
  <p>
   margin-left: $s-10;<br />
   padding: $s-10; - 3rem
  </p>
 </div>
 <div class="big-margin">
  <p>
   margin-left: $s-12;<br />
   padding: $s-12; - 4rem
  </p>
 </div>
</div>
