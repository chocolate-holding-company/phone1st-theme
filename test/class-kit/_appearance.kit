<div id="dropdown-menu-16" class="dropdown-menu">
 <pre><code class="language-scss">//cursor
cursor - cursor: default;
cursor-p - cursor: pointer;
cursor-h - cursor: help;
cursor-w - cursor: wait;
cursor-ch - cursor: crosshair;
cursor-na - cursor: not-allowed;
cursor-zi - cursor: zoom-in;
cursor-zo - cursor: zoom-out;
cursor-g - cursor: grab;

//list-style
list-none - list-style: none;
list-disc - list-style: disc;
list-decimal - list-style: decimal;
list-circle - list-style: circle;
list-square - list-style: square;
list-inside - list-style-position: inside;
list-outside - list-style-position: outside;

//media breakpoints
//@media min-width 768px, 1020px, 1200px, 1440px
//use _m, _l, _xl, _w at the end of the class

//examples
cursor-w_m - cursor: wait;//@768px
list-none_l - list-style: none;//@1020px
list-square_xl - list-style: square;//@1200px</code></pre>
</div>
