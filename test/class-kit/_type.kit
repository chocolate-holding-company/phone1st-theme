<div id="dropdown-menu-11" class="dropdown-menu">
 <pre><code class="language-scss">//font family
font - font-family: $font;
heading - font-family: $heading-font;
code - font-family: $code-font;

// Font Sizes (using variables)
text-xs - font-size: $third;
text-sm - font-size: $secondary;
text-base - font-size: $font-size;
text-lg - font-size: $lead;

//see css/base/_typography.scss
p - font-size: clamp(1.0625rem, 1.0057rem + 0.2424vw, 1.1875rem);

//headings
//set your css Clamp function settings at https://clamp.font-size.app
//see css/base/_typography.scss
//all clamp functions based on screen width 320px to 1100px
h1 - font-size: clamp(1.75rem, 1.3409rem + 1.8182vw, 2.75rem);
h2 - font-size: clamp(1.625rem, 1.2273rem + 1.697vw, 2.5rem);
h3 - font-size: clamp(1.5rem, 1.2159rem + 1.2121vw, 2.125rem);
h4 - font-size: clamp(1.25rem, 0.9659rem + 1.2121vw, 1.875rem);
h5 - font-size: clamp(1.125rem, 0.8409rem + 1.2121vw, 1.75rem);
h6 - font-size: clamp(1rem, 0.7159rem + 1.2121vw, 1.625rem);

//hyphens
hyphens-auto - hyphens: auto;
hyphens-man - hyphens: manual;
hyphens-none - hyphens: none;

//font weight
font-100 - font-weight: 100;
font-200 - font-weight: 200;
font-300 - font-weight: 300;
font-400 - font-weight: 400;
font-500 - font-weight: 500;
font-600 - font-weight: 600;
font-700 - font-weight: 700;
font-800 - font-weight: 800;
font-900 - font-weight: 900;


//align
text-center - text-align: center
text-left - text-align: left
text-right - text-align: right
text-justify - text-align: justify;

//font-style
normal: font-style: normal;
italic - font-style: italic;

//text-transform
upper - text-transform: uppercase;
lower - text-transform: lowercase;
caps - text-transform: capitalize;
normal-case - text-transform: none;

//letter spacing
ls-tighter - letter-spacing: -0.050em;
ls-tight - letter-spacing: -0.025em;
ls-0 - letter-spacing: normal;
ls-1 - letter-spacing: 0.0625rem;
ls-2 - letter-spacing: 0.125rem;
ls-3 - letter-spacing: 0.1875rem;
ls-4 - letter-spacing: 0.25rem;
ls-5 - letter-spacing: 0.3125rem;
ls-6 - letter-spacing: 0.375rem;
ls-7 - letter-spacing: 0.4375rem;
ls-8 - letter-spacing: 0.5rem;
ls-9 - letter-spacing: 0.5625rem;
ls-10 - letter-spacing: 0.625rem;

//line-height
lh-0 - line-hieght: 1;
lh-1 - line-height: 1.1;
lh-2 - line-height: 1.2;
lh-3 - line-height: 1.3;
lh-4 - line-height: 1.4;
lh-5 - line-height: 1.5;
lh-6 - line-height: 1.6;
lh-7 - line-height: 1.7;
lh-8 - line-height: 1.8;
lh-9 - line-height: 1.9;
lh-20 - line-height: 2;
lh-21 - line-height: 2.1;

//media breakpoints
//@media min-width  768px, 1020px, 1200px, 1440px
//use _m, _l, _xl, _w at the end of the class

//examples
text-lg_m - font-size: $lead;//@768px
text-center_l - text-align: center;//@1020px
ls-tight_xl - letter-spacing: -0.025em;//@1200px
lh-2_w - line-height: 1.2;//@71440px
font-300_l - font-weight: 300;//@1020px
caps_xl text-transform: capitalize;//@1200px</code></pre>
</div>
